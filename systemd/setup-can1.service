[Unit]
Description=Setup CAN1 interface (1 Mbps)
After=sys-subsystem-net-devices-can1.device
Requires=sys-subsystem-net-devices-can1.device

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/bash /home/yu/robot_code/stepper_motor_sdk/scripts/setup_jetson_can.sh can1 1000000

[Install]
WantedBy=multi-user.target
